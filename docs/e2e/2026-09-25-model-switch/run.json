{
  "env": {
    "AETHER_TEST_USER_DATA": "/tmp/unwritten-model-switch-ud",
    "CDP_PORT": "9333",
    "UI_LANGUAGE": "zh-TW",
    "OPENAI_API_KEY": "from local .env; never recorded here"
  },
  "model": "openai · gpt-5.4-mini; Apple on-device attempted for detection (fm license not accepted)",
  "actions": [
    { "wait": 1200 },
    { "clickText": "系統" },
    { "wait": 800 },
    { "text": true },
    { "shot": "docs/e2e/2026-09-25-model-switch/01-cloud.jpg" },
    { "clickText": "這台電腦" },
    { "wait": 400 },
    { "text": true },
    { "shot": "docs/e2e/2026-09-25-model-switch/02-local-detection.jpg" },
    { "clickText": "使用這個模型" },
    { "wait": 500 },
    { "text": true },
    { "shot": "docs/e2e/2026-09-25-model-switch/03-apple-license.jpg" },
    { "clickText": "雲端 API" },
    { "clickText": "自訂 API" },
    { "clickText": "API 金鑰" },
    { "type": "test-key-12345" },
    { "eval": "document.querySelector('input[type=password]')?.value.length" },
    { "clickText": "儲存金鑰" },
    { "wait": 200 },
    { "eval": "window.seed.inference.keyStatus().then(x => x.ok ? x.value.custom : x.error)" },
    { "clickText": "移除已存金鑰" },
    { "clickText": "OpenAI" },
    { "clickText": "使用這個模型" },
    { "wait": 500 },
    { "eval": "window.seed.inference.getConfig().then(x => ({kind:x.kind,model:x.model,sidecar:x.sidecar}))" },
    { "hold": "Escape", "ms": 80 },
    { "clickText": "創作遊戲" },
    { "wait": 3500 },
    { "text": true },
    { "shot": "docs/e2e/2026-09-25-model-switch/04-create-readiness.jpg" },
    { "clickText": "世界名稱" },
    { "type": "月光之島" },
    { "clickText": "用一句話說說，這片大地是什麼樣的地方？" },
    { "type": "一座會在夜裡發光的小島，居民守護海上的星圖。" },
    { "clickText": "規劃這個世界" },
    { "wait": 15000 },
    { "text": true },
    { "clickText": "建立並開始玩" },
    { "wait": 25000 },
    { "text": true },
    { "shot": "docs/e2e/2026-09-25-model-switch/05-created-world.jpg" }
  ]
}
