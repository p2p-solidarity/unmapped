{
  "env": {
    "userData": "fresh temporary directory via AETHER_TEST_USER_DATA (the same directory for both phases)",
    "debugPort": 9333,
    "locale": "zh-TW (system default)",
    "build": "main at afb0f8d..1a3306a (bun run dev)",
    "phases": "actions → stop the app completely (kill electron-vite and Electron) → start it again on the same userData → afterRestart"
  },
  "model": "openai · gpt-5.4-mini (System → Model, Cloud API, key from .env)",
  "actions": [
    { "clickText": "返回" },
    { "wait": 800 },
    { "clickText": "系統" },
    { "wait": 2500 },
    { "shot": "docs/e2e/milestone-integration/01-system-model.jpg" },
    { "clickText": "這台電腦" },
    { "wait": 2500 },
    { "shot": "docs/e2e/milestone-integration/02-model-local.jpg" },
    { "clickText": "Ollama" },
    { "wait": 800 },
    { "clickText": "雲端 API" },
    { "wait": 500 },
    { "hold": "Escape", "ms": 80 },
    { "wait": 600 },
    { "eval": "document.body.innerText.includes('加入房間')" },
    { "clickText": "創作遊戲" },
    { "wait": 800 },
    { "clickText": "開始新的遊戲" },
    { "wait": 1500 },
    { "eval": "document.querySelectorAll('input')[0].focus()" },
    { "type": "霧港巡禮" },
    { "eval": "document.querySelectorAll('input')[1].focus()" },
    { "type": "霧散之後，港邊的人輪流守著一盞會記住航線的燈，夜裡有東西從海霧裡爬上岸。" },
    { "clickText": "冒險 · 槍" },
    { "wait": 400 },
    { "shot": "docs/e2e/milestone-integration/04-idea.jpg" },
    { "clickText": "撰寫世界" },
    { "wait": 12000 },
    { "shot": "docs/e2e/milestone-integration/05-world.jpg" },
    { "eval": "const t=document.querySelectorAll('textarea')[1];t.focus();t.setSelectionRange(t.value.length,t.value.length)" },
    { "type": "遠處總有一盞燈亮著。" },
    { "eval": "document.querySelectorAll('input')[4].focus()" },
    { "type": "地名多用海邊的東西，例如堤、燈、網。" },
    { "eval": "[...document.querySelectorAll('button')].filter(b=>b.innerText.trim()==='重寫這張卡片')[4].click()" },
    { "wait": 9000 },
    { "eval": "[...document.querySelectorAll('textarea')].map(e=>e.value.slice(0,80))" },
    { "shot": "docs/e2e/milestone-integration/06-world-edited.jpg" },
    { "clickText": "繼續寫故事" },
    { "wait": 15000 },
    { "shot": "docs/e2e/milestone-integration/07-story.jpg" },
    { "eval": "[...document.querySelectorAll('button')].filter(b=>b.innerText.trim()==='鎖定')[2].click()" },
    { "wait": 300 },
    { "eval": "document.querySelectorAll('input,textarea')[4].focus()" },
    { "type": "讓這章在黃昏發生，多一位會說謊的老漁夫。" },
    { "eval": "[...document.querySelectorAll('button')].filter(b=>b.innerText.trim()==='重寫這章')[0].click()" },
    { "wait": 9000 },
    { "eval": "[...document.querySelectorAll('button')].filter(b=>b.innerText.trim()==='在此撰寫新章')[3].click()" },
    { "wait": 9000 },
    { "eval": "[...document.querySelectorAll('button')].filter(b=>b.innerText.trim()==='↓')[0].click()" },
    { "wait": 400 },
    { "eval": "JSON.stringify([...document.querySelectorAll('input')].filter(e=>e.maxLength===60).map(e=>e.value))" },
    { "shot": "docs/e2e/milestone-integration/08-story-edited.jpg" },
    { "eval": "window.__before=[...document.querySelectorAll('input,textarea')].map(e=>e.value); 'kept'" },
    { "eval": "[...document.querySelectorAll('textarea')].at(-1).focus()" },
    { "type": "讓後半段更緊張，但結局要溫暖。" },
    { "clickText": "修改未鎖定的章節" },
    { "wait": 14000 },
    { "eval": "const a=[...document.querySelectorAll('input,textarea')].map(e=>e.value); JSON.stringify({lockedTitleSame:a.includes('堤上來的東西'), lockedBriefSame:a.some(v=>v===window.__before.find(x=>x.startsWith('夜裡霧重'))), changed:a.filter((v,i)=>v!==window.__before[i]).length})" },
    { "shot": "docs/e2e/milestone-integration/09-story-note.jpg" }
  ],
  "afterRestart": [
    { "clickText": "創作遊戲" },
    { "wait": 1200 },
    { "shot": "docs/e2e/milestone-integration/10-drafts-after-restart.jpg" },
    { "eval": "[...document.querySelectorAll('button')].filter(b=>b.innerText.trim()==='繼續')[0].click()" },
    { "wait": 1200 },
    { "eval": "JSON.stringify({titles:[...document.querySelectorAll('input')].filter(e=>e.maxLength===60).map(e=>e.value), lock:[...document.querySelectorAll('button')].filter(b=>['鎖定','解鎖'].includes(b.innerText.trim())).map(b=>b.innerText.trim())})" },
    { "clickText": "前往建立" },
    { "wait": 1200 },
    { "shot": "docs/e2e/milestone-integration/11-build-review.jpg" },
    { "clickText": "建立並開始玩" },
    { "wait": 20000 },
    { "shot": "docs/e2e/milestone-integration/12-land.jpg" },
    { "hold": ["KeyD", "ShiftLeft"], "ms": 5000 },
    { "shot": "docs/e2e/milestone-integration/13-land-east.jpg" },
    { "hold": ["KeyS", "ShiftLeft"], "ms": 6000 },
    { "shot": "docs/e2e/milestone-integration/14-monsters.jpg" },
    { "click": [1080, 690] },
    { "wait": 3500 },
    { "click": [1150, 700] },
    { "wait": 3500 },
    { "click": [1150, 700] },
    { "wait": 3500 },
    { "shot": "docs/e2e/milestone-integration/16-approach.jpg" },
    { "wait": 1500 },
    { "shot": "docs/e2e/milestone-integration/17-attacked.jpg" },
    { "hold": "KeyV", "ms": 80 },
    { "wait": 1200 },
    { "shot": "docs/e2e/milestone-integration/18-attacked-pixel.jpg" },
    { "wait": 3000 },
    { "eval": "document.body.innerText.includes('你倒下了')" },
    { "clickText": "繼續四處看看" },
    { "wait": 1500 },
    { "shot": "docs/e2e/milestone-integration/20-revived.jpg" }
  ]
}
