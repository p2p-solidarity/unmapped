{
 "env": {
  "userData": "fresh empty temporary directory via AETHER_TEST_USER_DATA (first run: $TMPDIR/ud-p2-pad, found the stale cartridge list; after the fix: $TMPDIR/ud-p2-pad-a3, this list replayed whole)",
  "launch": "mkdir -p \"$TMPDIR/ud-p2-pad-a3\" && AETHER_TEST_USER_DATA=\"$TMPDIR/ud-p2-pad-a3\" bun run dev --remoteDebuggingPort 9333",
  "debugPort": 9333,
  "locale": "zh-TW (system default)",
  "window": "1440 × 868",
  "input": "keyboard and mouse (clickText, Escape)",
  "note": "Part A: the title's four entries, Settings as a dialog, the Worlds library's sections, a New game on 1.3.0, Continue, Saves and Cartridges. Starts on the title of a fresh userData; the Cartridges visit comes before any New game on purpose (the built-in world is installed by the New game panel)."
 },
 "model": "openai · gpt-5.4-mini (Settings → Model default on a fresh userData); nothing here needs the model, but Play writes chapter 1 and witnesses the land in the background",
 "actions": [
  {
   "eval": "({menu:[...document.querySelectorAll('button')].filter(b=>b.offsetParent).slice(0,4).map(b=>({t:b.innerText.trim(),disabled:b.disabled})), focus: document.activeElement?.innerText})"
  },
  {
   "shot": "docs/e2e/milestone-rev6-p2-gamepad/a-00-title.jpg"
  },
  {
   "clickText": "設定"
  },
  {
   "wait": 700
  },
  {
   "eval": "(()=>{const d=document.querySelector('[role=dialog]'); const menu=[...document.querySelectorAll('button')].find(b=>b.innerText.trim()==='世界'); return {dialog: d?.getAttribute('aria-label') ?? null, focusInDialog: d?.contains(document.activeElement) ?? false, focus: document.activeElement?.innerText?.slice(0,30), menuInert: menu?.closest('[inert]')!==null}})()"
  },
  {
   "shot": "docs/e2e/milestone-rev6-p2-gamepad/a-01-settings-dialog.jpg"
  },
  {
   "hold": "Escape",
   "ms": 80
  },
  {
   "wait": 500
  },
  {
   "eval": "({dialog: document.querySelector('[role=dialog]') !== null, focus: document.activeElement?.innerText, inert: document.querySelectorAll('[inert]').length})"
  },
  {
   "clickText": "世界"
  },
  {
   "wait": 1500
  },
  {
   "eval": "({nav:[...document.querySelectorAll('.library__nav button')].map(b=>b.innerText.replace(/\\n/g,' ')), panel: document.querySelector('.library__panel')?.innerText.slice(0,300)})"
  },
  {
   "shot": "docs/e2e/milestone-rev6-p2-gamepad/a-02-library-new.jpg"
  },
  {
   "clickText": "卡帶"
  },
  {
   "wait": 1000
  },
  {
   "eval": "({nav:[...document.querySelectorAll('.library__nav button')].map(b=>b.innerText.replace(/\\n/g,' ')), rows:[...document.querySelectorAll('.cart-row')].map(r=>r.innerText.replace(/\\n/g,' | ')), none: document.querySelector('.library__panel')?.innerText.includes('還沒有卡帶')})"
  },
  {
   "shot": "docs/e2e/milestone-rev6-p2-gamepad/a-03-cartridges.jpg"
  },
  {
   "clickText": "大陸"
  },
  {
   "wait": 800
  },
  {
   "eval": "({nav:[...document.querySelectorAll('.library__nav button')].map(b=>b.innerText.replace(/\\n/g,' ')), panel: document.querySelector('.library__panel')?.innerText.slice(0,300)})"
  },
  {
   "shot": "docs/e2e/milestone-rev6-p2-gamepad/a-04-continent.jpg"
  },
  {
   "clickText": "存檔"
  },
  {
   "wait": 800
  },
  {
   "eval": "({nav:[...document.querySelectorAll('.library__nav button')].map(b=>b.innerText.replace(/\\n/g,' ')), panel: document.querySelector('.library__panel')?.innerText.slice(0,300)})"
  },
  {
   "clickText": "新遊戲"
  },
  {
   "wait": 1000
  },
  {
   "eval": "window.__e2e={t0:Date.now()}; true"
  },
  {
   "clickText": "開始"
  },
  {
   "eval": "(async()=>{const S=await import('/state/index.ts'); for(let i=0;i<120;i++){const s=S.useSessionStore.getState(); if(s.screen==='play'&&s.activeInstance) return {ms:Date.now()-window.__e2e.t0, cartridge:s.activeInstance.instance.save.cartridge}; await new Promise(r=>setTimeout(r,250));} return S.useSessionStore.getState().screen})()"
  },
  {
   "wait": 2500
  },
  {
   "shot": "docs/e2e/milestone-rev6-p2-gamepad/a-05-play-new-game.jpg"
  },
  {
   "clickText": "← 主頁"
  },
  {
   "wait": 1500
  },
  {
   "eval": "({menu:[...document.querySelectorAll('button')].filter(b=>b.offsetParent).slice(0,4).map(b=>({t:b.innerText.trim(),disabled:b.disabled})), focus: document.activeElement?.innerText})"
  },
  {
   "shot": "docs/e2e/milestone-rev6-p2-gamepad/a-06-title-continue.jpg"
  },
  {
   "clickText": "世界"
  },
  {
   "wait": 1000
  },
  {
   "clickText": "存檔"
  },
  {
   "wait": 1000
  },
  {
   "eval": "({nav:[...document.querySelectorAll('.library__nav button')].map(b=>b.innerText.replace(/\\n/g,' ')), panel: document.querySelector('.library__panel')?.innerText.slice(0,300)})"
  },
  {
   "shot": "docs/e2e/milestone-rev6-p2-gamepad/a-07-saves.jpg"
  },
  {
   "clickText": "卡帶"
  },
  {
   "wait": 1000
  },
  {
   "eval": "({rows:[...document.querySelectorAll('.cart-row')].map(r=>r.innerText.replace(/\\n/g,' | ')), detail: document.querySelector('.detail')?.innerText.slice(0,300)})"
  },
  {
   "shot": "docs/e2e/milestone-rev6-p2-gamepad/a-08-cartridges-after.jpg"
  },
  {
   "clickText": "← 標題畫面"
  },
  {
   "wait": 1000
  },
  {
   "clickText": "繼續"
  },
  {
   "eval": "(async()=>{const S=await import('/state/index.ts'); for(let i=0;i<60;i++){const s=S.useSessionStore.getState(); if(s.screen==='play'&&s.activeInstance) return {screen:s.screen, version:s.activeInstance.instance.save.cartridge.version}; await new Promise(r=>setTimeout(r,250));} return S.useSessionStore.getState().screen})()"
  },
  {
   "wait": 1200
  },
  {
   "shot": "docs/e2e/milestone-rev6-p2-gamepad/a-09-continue-play.jpg"
  },
  {
   "clickText": "← 主頁"
  },
  {
   "wait": 1000
  },
  {
   "eval": "({menu:[...document.querySelectorAll('button')].filter(b=>b.offsetParent).slice(0,4).map(b=>({t:b.innerText.trim(),disabled:b.disabled})), focus: document.activeElement?.innerText})"
  }
 ]
