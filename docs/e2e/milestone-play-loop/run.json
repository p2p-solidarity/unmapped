    { "eval": "(async()=>{const s=await import('/state/index.ts');const p=s.useLandStore.getState().progress?.places?.[0];return p?[p.kind,p.title,Object.keys(p.dialogues||{})]:null})()" },
    { "shot": "docs/e2e/milestone-play-loop/08-place-generation.jpg" },
    { "clickText": "關閉" },
    { "eval": "(async()=>{const s=await import('/state/index.ts');const p=s.useLandStore.getState().progress.places[0];s.useEngineStore.getState().requestTeleport(p.cx*32+16.5,p.cz*32+17.5);return [p.id,p.cx,p.cz]})()" },
    { "wait": 700 },
    { "hold": "KeyE", "ms": 100 },
    { "wait": 1300 },
    { "text": true },
    { "shot": "docs/e2e/milestone-play-loop/09-place-entered.jpg" },
    { "eval": "(async()=>{const p=await import('/app/land/places.ts');const s=await import('/state/index.ts');const id=s.useSessionStore.getState().place?.graph.npcs[0]?.id;if(id)p.talkInPlace(id);return id||null})()" },
    { "wait": 300 },
    { "text": true },
    { "shot": "docs/e2e/milestone-play-loop/10-place-resident.jpg" }
