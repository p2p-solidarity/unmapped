{
  "flow": "ENS names in the lineage tree from the app: a remix cartridge, the player's own save, its update, a backup restored on another machine that finds its name by hash, and a lookup by name",
  "env": {
    "app A": "UNWRITTEN_PRIVATE_KEY= UNWRITTEN_LINEAGE_RELAY=http://127.0.0.1:8790 UNWRITTEN_SIGN_BROWSER=none AETHER_TEST_USER_DATA=<fresh dir> AETHER_TEST_BACKUP_PATH=.cache/e2e/save.spire-backup bun run dev --remoteDebuggingPort 9336",
    "app B ('another machine')": "UNWRITTEN_PRIVATE_KEY= UNWRITTEN_LINEAGE_RELAY= UNWRITTEN_SIGN_BROWSER=none AETHER_TEST_USER_DATA=<another fresh dir> AETHER_TEST_BACKUP_PATH=.cache/e2e/save.spire-backup bun run dev --remoteDebuggingPort 9337   (no passkey, no gas station)",
    "station": "wrangler dev on port 8790 (see milestone-lineage-relay)",
    "fixture": "moss-hollow 1.0.0: the shipped aether-land 1.3.0 input with cartridgeId moss-hollow and lineage {kind: remix, parent: aether-land@1.3.0}, published into app A's library with publishCartridgeRevision (a test library only; `bun run demo:cartridges` currently fails in forge.ts)",
    "passkey": "CDP WebAuthn virtual authenticator, as in milestone-lineage-relay",
    "contracts": "v2: registry 0xda8051e3e2855C125AAd6050f97Ea64cf203dAf6 under unmapped.eth"
  },
  "model": "openai gpt-5.4-mini (only New Game's opening; naming asks no model)",
  "runs": {
    "cartridges (app A)": [
      {
        "clickText": "世界"
      },
      {
        "wait": 2500
      },
      {
        "clickText": "卡帶"
      },
      {
        "wait": 3000
      },
      {
        "text": true
      },
      {
        "shot": "docs/e2e/milestone-lineage-names/01-cartridges.jpg"
      },
      {
        "eval": "[...document.querySelectorAll(\"button\")].find(b=>b.textContent.includes(\"1.2.0\"))?.click()"
      },
      {
        "wait": 4000
      },
      {
        "shot": "docs/e2e/milestone-lineage-names/02-other-version.jpg"
      },
      {
        "eval": "[...document.querySelectorAll(\"button\")].find(b=>b.textContent.includes(\"Moss Hollow\"))?.click()"
      },
      {
        "wait": 4000
      },
      {
        "shot": "docs/e2e/milestone-lineage-names/03-remix-free.jpg"
      },
      {
        "clickText": "用 passkey 登記名稱"
      },
      {
        "wait": 5000
      },
      "… sign on the page …",
      {
        "wait": 4000
      },
      {
        "text": true
      },
      {
        "shot": "docs/e2e/milestone-lineage-names/05-remix-named.jpg"
      }
    ],
    "save (app A)": [
      {
        "clickText": "世界"
      },
      {
        "wait": 2000
      },
      {
        "clickText": "新遊戲"
      },
      {
        "wait": 2500
      },
      {
        "clickText": "開始"
      },
      {
        "wait": 20000
      },
      {
        "clickText": "← 主頁"
      },
      {
        "wait": 4000
      },
      {
        "clickText": "世界"
      },
      {
        "wait": 2000
      },
      {
        "clickText": "存檔"
      },
      {
        "wait": 10000
      },
      {
        "shot": "docs/e2e/milestone-lineage-names/11-save-block-new.jpg"
      },
      {
        "eval": "document.getElementById(\"save-ens-label\").select()"
      },
      {
        "type": "first-light"
      },
      {
        "wait": 3000
      },
      {
        "clickText": "用 passkey 記錄"
      },
      {
        "wait": 5000
      },
      "… sign on the page …",
      {
        "clickText": "世界"
      },
      {
        "wait": 2000
      },
      {
        "clickText": "存檔"
      },
      {
        "wait": 10000
      },
      {
        "shot": "docs/e2e/milestone-lineage-names/12-save-recorded.jpg"
      },
      {
        "clickText": "備份存檔"
      },
      {
        "wait": 5000
      },
      "(after the fingerprint fix, app A restarted)",
      {
        "clickText": "世界"
      },
      {
        "wait": 2000
      },
      {
        "clickText": "存檔"
      },
      {
        "wait": 10000
      },
      {
        "shot": "docs/e2e/milestone-lineage-names/14-save-outdated.jpg"
      },
      {
        "clickText": "更新到目前進度"
      },
      {
        "wait": 5000
      },
      "… sign on the page …",
      {
        "shot": "docs/e2e/milestone-lineage-names/15-save-updated.jpg"
      }
    ],
    "restore and look up (app B)": [
      {
        "clickText": "世界"
      },
      {
        "wait": 2500
      },
      {
        "clickText": "存檔"
      },
      {
        "wait": 3000
      },
      {
        "clickText": "還原備份"
      },
      {
        "wait": 12000
      },
      {
        "text": true
      },
      {
        "shot": "docs/e2e/milestone-lineage-names/16-restored-verified.jpg"
      },
      {
        "clickText": "卡帶"
      },
      {
        "wait": 3000
      },
      {
        "eval": "document.querySelector(\"input[placeholder]\").focus()"
      },
      {
        "type": "first-light.aether-land.unmapped.eth"
      },
      {
        "clickText": "查詢"
      },
      {
        "wait": 9000
      },
      {
        "text": true
      },
      {
        "shot": "docs/e2e/milestone-lineage-names/17-open-save-name.jpg"
      }
    ],
    "every signature (page side, the newest sign URL)": [
      {
        "cdp": {
          "method": "WebAuthn.enable",
          "params": {
            "enableUI": false
          }
        }
      },
      {
        "cdp": {
          "method": "WebAuthn.addVirtualAuthenticator",
          "params": {
            "options": {
              "protocol": "ctap2",
              "ctap2Version": "ctap2_1",
              "transport": "internal",
              "hasResidentKey": true,
              "hasUserVerification": true,
              "isUserVerified": true,
              "automaticPresenceSimulation": true
            }
          }
        }
      },
      {
        "cdp": {
          "method": "WebAuthn.addCredential",
          "params": {
            "authenticatorId": "$authenticatorId",
            "credential": "<the exported credential (.cache/e2e/browser-credential.json)>"
          }
        }
      },
      {
        "text": true
      },
      {
        "clickText": "Approve with Touch ID"
      },
      {
        "wait": 40000
      },
      {
        "text": true
      },
      {
        "eval": "document.querySelector('#status a')?.href"
      }
    ]
  },
  "web_view": "18-web-name-tree.jpg: https://unmapped-auction.gimmychang.workers.dev in the headless Chrome, 1440 × 2500, 14 s after load"
}
