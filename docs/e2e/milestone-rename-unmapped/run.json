    { "eval": "[...document.querySelectorAll('button')].find(b=>b.innerText.includes('Esc'))?.click()" },
    { "wait": 1000 },
    { "clickText": "繼續遊戲" },
    { "wait": 5000 },
    { "eval": "(async()=>{const m=await import('/engine/playerProbe.ts');const s=await import('/state/index.ts');return JSON.stringify({p:m.samplePlayer(),chunk:s.useEngineStore.getState().chunk,near:s.useEngineStore.getState().nearby})})()" },
    { "eval": "(async()=>{const s=await import('/state/index.ts');s.useEngineStore.getState().requestTeleport(72.5,27.5);await new Promise(r=>setTimeout(r,500));const m=await import('/engine/playerProbe.ts');return JSON.stringify({p:m.samplePlayer(),tp:s.useEngineStore.getState().teleport})})()" },
    { "hold": "KeyD", "ms": 1900 },
    { "hold": "KeyW", "ms": 2400 },
    { "wait": 400 },
    { "eval": "(async()=>{const m=await import('/engine/playerProbe.ts');const s=await import('/state/index.ts');return JSON.stringify({p:m.samplePlayer(),near:s.useEngineStore.getState().nearby})})()" },
    { "hold": "KeyE", "ms": 80 },
    { "wait": 2500 },
    { "eval": "(async()=>{const s=await import('/state/index.ts');return JSON.stringify({place:s.useSessionStore.getState().place?.id??null,landReturn:s.useSessionStore.getState().landReturn,tp:s.useEngineStore.getState().teleport})})()" },
    { "shot": "docs/e2e/milestone-rename-unmapped/05-in-dungeon.jpg" },
    { "hold": "KeyE", "ms": 80 },
    { "wait": 2500 },
    { "eval": "(async()=>{const m=await import('/engine/playerProbe.ts');const s=await import('/state/index.ts');return JSON.stringify({p:m.samplePlayer(),place:s.useSessionStore.getState().place?.id??null,landReturn:s.useSessionStore.getState().landReturn})})()" },
    { "shot": "docs/e2e/milestone-rename-unmapped/06-back-at-entrance.jpg" }
  ]
