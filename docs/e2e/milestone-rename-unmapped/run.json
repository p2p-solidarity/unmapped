  "model": "none: no model call in this run",
  "actions": [
    { "eval": "document.title" },
    { "shot": "docs/e2e/milestone-rename-unmapped/03-title-ja.jpg" },
    { "clickText": "システム" },
    { "wait": 1000 },
    { "clickText": "English" },
    { "wait": 600 },
    { "hold": "Escape", "ms": 80 },
    { "wait": 800 },
    { "eval": "document.querySelector('.title__crest').innerText" },
    { "shot": "docs/e2e/milestone-rename-unmapped/02-title-en.jpg" },
    { "clickText": "System" },
    { "wait": 1000 },
    { "clickText": "繁體中文" },
    { "wait": 600 },
    { "hold": "Escape", "ms": 80 },
    { "wait": 800 },
    { "eval": "document.querySelector('.title__crest').innerText" },
    { "shot": "docs/e2e/milestone-rename-unmapped/01-title-zh-TW.jpg" },
    { "clickText": "新遊戲" },
    { "wait": 2500 },
    { "eval": "document.body.innerText.slice(0,160)" },
