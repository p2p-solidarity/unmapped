{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@dsl": ["src/dsl/index.ts"],
      "@dsl/*": ["src/dsl/*"],
      "@renderer/*": ["src/renderer/*"]
    }
  },
  "include": ["src/browser/**/*", "src/preload/api.d.ts", "src/renderer/env.d.ts"]
}
