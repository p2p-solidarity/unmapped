root = Scene("Rail Cutting Run", "countryside", [floor1, sky1, light1, light2, aya, plum_jar, tool_box, reach_the_bridge])
floor1 = Floor(20, 20, "grass")
sky1 = Sky("#c9dbe4", "#e6ecea", 0.02)
light1 = Light("ambient", "#fff1d6", 0.8)
light2 = Light("sun", "#fff3d6", 1.2)
aya = NPC("aya", "Aya", 1, 1, "farmer", "joyful", "#a7b85a")
plum_jar = Treasure("plum_jar", 1, 1, ["pickled plum"])
tool_box = Treasure("tool_box", 1, 1, ["rusty spanner", "twine"])
reach_the_bridge = Quest("reach_the_bridge", "Cross the flooded rail cutting to the footbridge at the far end.")
