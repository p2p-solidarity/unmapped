e1 = Find("lost_umbrella", "chie", "A grey umbrella blew off the bench in the wind. It must be caught somewhere on the verge.", 6, 25, "k_umbrella", "That is the one. Keep this tag; it matches the umbrella's.")
e2 = Find("lost_glove", "chie", "One work glove, the left one, fell off the milk truck by the ditch.", 3, 28, "k_glove", "The left one, yes. The right one has been waiting on my shelf since June.")
e3 = Find("lost_thermos", "chie", "The bus driver left his thermos on the wall behind the shelter. Tea still in it, I expect.", 12, 4, "k_thermos", "Still warm, even. He will be glad.")
e4 = Find("lost_book", "chie", "A library book with a green cover, somewhere up by the steel fence.", 22, 3, "k_book", "Overdue by a month. The library will forgive it.")
e5 = Find("lost_radio", "chie", "A small radio, still playing, somewhere past the crates. You can hear it if you stand still.", 28, 9, "k_radio", "The weather report, still going. Thank you.")
e6 = Find("lost_scarf", "chie", "A blue scarf went over the fence with the first cold wind.", 4, 19, "k_scarf", "It smells of the bathhouse. I know whose it is.")
e7 = Find("lost_lunch_tin", "chie", "A child's lunch tin, the dented one, was left under the far tree.", 19, 28, "k_lunch", "Empty, of course. Children eat first and lose things after.")
e8 = Find("lost_glasses", "nobu", "Grandpa Seki lost his reading glasses in the grass. He cannot find them without them.", 13, 21, "k_glasses", "Ha! I will run them over to him.")
e9 = Find("lost_keyring", "nobu", "Somebody dropped a key ring with a wooden fish on it near the verge.", 24, 20, "k_keyring", "A fish key ring. That is the shop's spare key!")
e10 = Find("lost_bell", "nobu", "I lost the bicycle bell I found. It is somewhere by the far corner.", 29, 27, "k_bell", "Now I have found it twice.")
e11 = Find("lost_cap", "nobu", "A school cap blew off at the corner by the road.", 2, 4, "k_cap", "It has a name inside. Chie will write the tag.")
e12 = Find("lost_postcard", "nobu", "A postcard with a lighthouse on it, near the signpost up the road.", 21, 6, "k_postcard", "Nobody has written on it yet. Maybe you should.")
e13 = Find("lost_marble", "nobu", "My best marble, the blue one, rolled off toward the top corner.", 27, 2, "k_marble", "The blue one! Keep the red one, I have too many.")
