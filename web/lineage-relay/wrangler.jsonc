// The Market's gas station on Cloudflare (src/relay/worker.ts). Only public addresses live here;
// the one secret is the station's key, which you add yourself:
//   bun run relay:key                                    (makes .cache/relay/relayer.key, prints its address)
//   bunx wrangler@4 secret put RELAYER_KEY -c web/lineage-relay/wrangler.jsonc < .cache/relay/relayer.key
//   bun run relay:deploy
// Then point the app at it: UNWRITTEN_LINEAGE_RELAY=https://unmapped-relay.<subdomain>.workers.dev
{
  "name": "unmapped-relay",
  "main": "../../src/relay/worker.ts",
  "account_id": "b9e60d05860dfe2eaf2db7f9930875c0",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "vars": {
    "RPC_URL": "https://ethereum-sepolia-rpc.publicnode.com",
    "REGISTRY": "0xda8051e3e2855C125AAd6050f97Ea64cf203dAf6",
    "HOOK": "0x59FA49D974B4564Eade17EDDC4a3CCf8D819a044",
    "ROUTER": "0x2201fBDB7f17BD687d8965B9Dc2Ae000689039BE",
    "ACCOUNTS": "0x7B8b8E17590cC85c315d459feD8fC9384C2c9bE5",
    "USDC": "0x16f95d91dba7da3aca778ec053df0ff6c6a8aa8e",
    "PERMIT2": "0x000000000022D473030F116dDEE9F6B43aC78BA3",
    "MAX_FEE_GWEI": "30",
    // A player's in-app launch (~5M gas) waits for gas under this instead.
    "MAX_LAUNCH_FEE_GWEI": "5"
  },
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "4801", "simple": { "limit": 30, "period": 60 } }
  ]
}
