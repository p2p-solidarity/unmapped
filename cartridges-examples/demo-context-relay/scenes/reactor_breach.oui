root = Scene("反應爐缺口", "cyber_workshop", [contract, floor, sky, ambient, sun, breach_glow, breach, back_wall, cover_w, cover_e, reactor, pipes_w, pipes_e, boiler, crate_a, crate_b, drone_a, drone_b, warden, exit, seal])
contract = Contract("reactor_breach", "fps_puzzle@1", ["scaffold_crossed"], [], "carry", ["breach_sealed"], true)
floor = Floor(19, 19, "stone")
sky = Sky("#0d1524", "#101a2c", 0.035)
ambient = Light("ambient", "#7fa8d4", 0.5)
sun = Light("sun", "#ffd9a0", 0.9)
breach_glow = Light("point", "#7dff9a", 2, 9, 3)
breach = Patch(7, 1, 5, 3, "lava")
back_wall = Wall(0, 0, 19, 3, "stone")
cover_w = Wall(3, 6, 4, 2, "stone")
cover_e = Wall(12, 6, 4, 2, "stone")
reactor = Prop("reactor", 9, 2, 2)
pipes_w = Prop("pipe_stack", 1, 12, 1.4)
pipes_e = Prop("pipe_stack", 17, 12, 1.4)
boiler = Prop("boiler", 15, 16)
crate_a = Prop("crate", 4, 15)
crate_b = Prop("crate", 5, 15)
drone_a = Monster("drone_a", "drone", 5, 4, 1, "孢子干擾")
drone_b = Monster("drone_b", "drone", 13, 4, 2, "孢子干擾")
warden = Monster("warden", "golem", 9, 5, 3, "菌絲纏繞", 1.3)
exit = Exit(9, 16, "封住裂縫")
seal = Quest("seal", "清除缺口前的無人機，封住裂縫。")
