root = Scene("浮空棧架", "sky_isle", [contract, floor, sky, ambient, sun, drop_north, drop_south, barrier, step_low, step_mid, ledge, landing, launch_pad, high_board, crane, gear, fence_a, fence_b, statue, sign, exit, cross])
contract = Contract("sky_scaffold", "platformer_2_5d@1", ["relay_map"], [], "carry", ["scaffold_crossed"], false)
floor = Floor(31, 9, "stone")
sky = Sky("#16243a", "#22384f", 0.02)
ambient = Light("ambient", "#bcd8ff", 0.6)
sun = Light("sun", "#fff2d0", 1.3)
drop_north = Patch(0, 0, 31, 3, "void")
drop_south = Patch(0, 6, 31, 3, "void")
barrier = Wall(20, 4, 1, 3, "stone")
step_low = Platform(16, 3, 2, 3, 1, 0.4, "wood")
step_mid = Platform(18, 3, 2, 3, 2, 0.4, "wood")
ledge = Platform(21, 3, 3, 3, 1.5, 0.4, "wood")
landing = Platform(8, 3, 3, 3, 1.2, 0.4, "stone")
launch_pad = Platform(25, 3, 1, 3, 0.5, 0.3, "stone", true)
high_board = Platform(26, 3, 2, 3, 3, 0.4, "wood")
crane = Prop("crane", 3, 1, 1.4)
gear = Prop("machine_gear", 10, 7, 1.5)
fence_a = Prop("fence", 14, 1)
fence_b = Prop("fence", 22, 7)
statue = Prop("statue", 5, 7)
sign = Prop("signpost", 17, 7)
exit = Exit(29, 4, "反應爐缺口")
cross = Quest("cross", "沿著棧架跳過斷牆，抵達另一端。")
