root = Scene("孢子穹頂", "meadow", [contract, floor, sky, ambient, sun, spores, path, pond, well, cap_a, cap_b, cap_c, cap_d, tree_a, tree_b, flowers_a, flowers_b, rock, sign, mira, old_root, spore_cache, scaffold_view, exit, talk_mira])
contract = Contract("spore_hub", "tps_exploration@1", [], [], "carry", ["relay_map"], false)
floor = Floor(23, 23, "grass")
sky = Sky("#101a12", "#16281a", 0.04)
ambient = Light("ambient", "#a8e6b0", 0.55)
sun = Light("sun", "#dff5c0", 0.9)
spores = Light("point", "#7dff9a", 1.6, 11, 11)
path = Patch(11, 13, 1, 9, "sand")
pond = Patch(3, 15, 4, 4, "water")
well = Prop("well", 11, 5)
cap_a = Prop("mushroom", 5, 6, 2.4)
cap_b = Prop("mushroom", 17, 7, 3)
cap_c = Prop("mushroom", 18, 16, 2)
cap_d = Prop("mushroom", 7, 11, 1.6)
tree_a = Prop("tree", 3, 3, 1.5)
tree_b = Prop("tree", 20, 3, 1.5)
flowers_a = Prop("flower", 14, 14)
flowers_b = Prop("flower", 8, 17)
rock = Prop("rock", 16, 19, 1.3)
sign = Prop("signpost", 12, 19)
mira = NPC("mira", "米菈", 13, 11, "bard", "joyful", "#c89bff")
old_root = NPC("old_root", "老根", 9, 8, "elder", "calm", "#8a6f4e")
spore_cache = Treasure("spore_cache", 4, 5, ["發光孢子", "菌絲繩"])
scaffold_view = Trigger("scaffold_view", 11, 20, 2, "see_scaffold")
exit = Exit(11, 21, "浮空棧架")
