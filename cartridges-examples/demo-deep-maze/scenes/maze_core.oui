root = Scene("迷宮核心", "abyss", [contract, floor, sky, ambient, core_glow, pool, core_cache, exit, escape])
contract = Contract("maze_core", "dungeon_grid@1", ["upper_cleared"], [], "carry", ["maze_escaped"], true)
floor = Floor(25, 25, "stone")
sky = Sky("#08131a", "#0c1d26", 0.07)
ambient = Light("ambient", "#5f9ea0", 0.4)
core_glow = Light("point", "#9fe8ff", 2, 12, 12)
pool = Patch(11, 11, 3, 3, "water")
core_cache = Treasure("core_cache", 21, 3, ["迷宮之心"])
exit = Exit(1, 1, "出口")
escape = Quest("escape", "帶著迷宮之心，從最深處的出口離開。")
