root = Scene("上層迷宮", "ruined_castle", [contract, floor, sky, ambient, torchlight, relic_cache, exit, descend])
contract = Contract("maze_upper", "dungeon_grid@1", [], [], "carry", ["upper_cleared"], false)
floor = Floor(21, 21, "stone")
sky = Sky("#14131a", "#221f2b", 0.06)
ambient = Light("ambient", "#b9b2cc", 0.45)
torchlight = Light("point", "#ffb36b", 1.6, 10, 10)
relic_cache = Treasure("relic_cache", 3, 17, ["古老的齒輪", "褪色的地圖"])
exit = Exit(19, 19, "迷宮核心")
descend = Quest("descend", "在迷宮重組之前，找到往下的階梯。")
