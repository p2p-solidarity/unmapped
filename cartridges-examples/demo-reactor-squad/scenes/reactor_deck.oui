root = Scene("反應爐甲板", "cyber_workshop", [contract, floor, sky, ambient, sun, glow, shaft, back_wall, front_wall, cover_nw, cover_ne, cover_sw, cover_se, reactor, gear, boiler, pipes_w, pipes_e, belt, crate_a, crate_b, drone_a, drone_b, golem_a, exit, secure_deck])
contract = Contract("reactor_deck", "fps_puzzle@1", [], [], "carry", ["deck_secured"], false)
floor = Floor(21, 21, "stone")
sky = Sky("#0d1524", "#101a2c", 0.03)
ambient = Light("ambient", "#7fa8d4", 0.5)
sun = Light("sun", "#ffd9a0", 1)
glow = Light("point", "#ff6a3d", 2.2, 10, 3)
shaft = Patch(8, 1, 5, 4, "void")
back_wall = Wall(0, 0, 21, 3, "stone")
front_wall = Wall(0, 20, 21, 3, "stone")
cover_nw = Wall(4, 6, 4, 2, "stone")
cover_ne = Wall(13, 6, 4, 2, "stone")
cover_sw = Wall(4, 14, 4, 2, "stone")
cover_se = Wall(13, 14, 4, 2, "stone")
reactor = Prop("reactor", 10, 3, 2)
gear = Prop("machine_gear", 3, 3, 1.5)
boiler = Prop("boiler", 17, 3)
pipes_w = Prop("pipe_stack", 2, 10, 1.4)
pipes_e = Prop("pipe_stack", 18, 10, 1.4)
belt = Prop("conveyor", 6, 17)
crate_a = Prop("crate", 15, 12)
crate_b = Prop("crate", 16, 12)
drone_a = Monster("drone_a", "drone", 6, 4, 1, "冷卻液")
drone_b = Monster("drone_b", "drone", 15, 4, 1, "冷卻液")
golem_a = Monster("golem_a", "golem", 10, 16, 2, "共振頻率", 1.3)
exit = Exit(10, 18, "冷卻脊管")
secure_deck = Quest("secure_deck", "肅清甲板上的巡邏無人機，與小隊會合。")
