root = Scene("核心室", "cyber_workshop", [contract, floor, sky, ambient, core_light, rim_light, melt, back_wall, cover_w, cover_e, core, gear_w, gear_e, pipes_w, pipes_e, crane, core_warden, drone_e, drone_f, exit, shutdown])
contract = Contract("core_chamber", "fps_puzzle@1", ["coolant_vented"], [], "carry", ["reactor_shutdown"], true)
floor = Floor(19, 19, "stone")
sky = Sky("#1a0d0b", "#2a120c", 0.045)
ambient = Light("ambient", "#d48f6a", 0.45)
core_light = Light("point", "#ff6a3d", 3, 9, 3)
rim_light = Light("sun", "#7fa8d4", 0.8)
melt = Patch(6, 1, 7, 4, "lava")
back_wall = Wall(0, 0, 19, 4, "stone")
cover_w = Wall(3, 12, 3, 2, "stone")
cover_e = Wall(13, 12, 3, 2, "stone")
core = Prop("reactor", 9, 3, 3)
gear_w = Prop("machine_gear", 2, 2, 2)
gear_e = Prop("machine_gear", 16, 2, 2)
pipes_w = Prop("pipe_stack", 1, 9, 1.5)
pipes_e = Prop("pipe_stack", 17, 9, 1.5)
crane = Prop("crane", 15, 16)
core_warden = Monster("core_warden", "golem", 9, 6, 5, "停機密碼", 2, "#ff6a3d")
drone_e = Monster("drone_e", "drone", 4, 7, 3, "冷卻液")
drone_f = Monster("drone_f", "drone", 14, 7, 3, "冷卻液")
exit = Exit(9, 17, "停機")
shutdown = Quest("shutdown", "擊倒核心守衛，手動停機反應爐。")
