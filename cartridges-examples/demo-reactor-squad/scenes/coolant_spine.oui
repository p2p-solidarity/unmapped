root = Scene("冷卻脊管", "snowfield", [contract, floor, sky, ambient, chill, channel_w, channel_e, cover_w, cover_e, cover_mid, pipes_nw, pipes_ne, pipes_sw, pipes_se, boiler, belt, crate_a, crate_b, drone_c, drone_d, golem_b, coolant_cache, exit, vent])
