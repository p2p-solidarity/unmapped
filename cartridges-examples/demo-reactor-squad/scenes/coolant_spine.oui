floor = Floor(13, 29, "stone")
sky = Sky("#111a22", "#1b2a36", 0.05)
ambient = Light("ambient", "#cfe6f5", 0.5)
chill = Light("point", "#8fd8ff", 1.6, 6, 14)
channel_w = Patch(0, 0, 2, 29, "water")
channel_e = Patch(11, 0, 2, 29, "water")
