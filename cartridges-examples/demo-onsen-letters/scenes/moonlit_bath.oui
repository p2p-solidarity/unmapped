root = Scene("月見湯", "onsen_town", [contract, floor, sky, ambient, moon, bath, rock_w, rock_e, torch_w, torch_e, flowers, chiyo, exit, answer])
contract = Contract("moonlit_bath", "vn_fixed@1", ["found_letters"], [], "carry", ["letters_answered"], true)
floor = Floor(11, 9, "stone")
sky = Sky("#101427", "#1d2036", 0.05)
ambient = Light("ambient", "#b8c4ff", 0.5)
moon = Light("point", "#ffe9c9", 1.8, 5, 3)
bath = Patch(0, 0, 11, 3, "water")
rock_w = Prop("rock", 1, 3, 1.4)
rock_e = Prop("rock", 9, 3, 1.2)
torch_w = Prop("torch", 1, 7)
torch_e = Prop("torch", 9, 7)
flowers = Prop("flower", 3, 7)
chiyo = NPC("chiyo", "千代", 5, 3, "merchant", "mournful", "#b0426a", "tall", "ribbon", "fan")
exit = Exit(7, 4, "天亮")
answer = Quest("answer", "在月光下，把三封信交還給寄信的人。")
