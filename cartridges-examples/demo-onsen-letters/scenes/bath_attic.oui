root = Scene("湯屋閣樓", "onsen_town", [contract, floor, sky, ambient, lantern, rafter_n, rafter_s, trunk_a, trunk_b, trunk_c, trunk_d, shrine, statue, torch, guest, letter_two, letter_three, exit, attic])
contract = Contract("bath_attic", "tps_exploration@1", ["heard_rumor"], [], "carry", ["found_letters"], false)
floor = Floor(15, 15, "wood")
sky = Sky("#140f14", "#1f171d", 0.09)
ambient = Light("ambient", "#9c7f8c", 0.35)
lantern = Light("point", "#ffc98a", 1.5, 7, 7)
rafter_n = Wall(0, 0, 15, 3, "wood")
rafter_s = Wall(0, 5, 4, 1, "wood")
trunk_a = Prop("crate", 2, 2)
trunk_b = Prop("crate", 3, 2, 0.8)
trunk_c = Prop("crate", 12, 9, 1.2)
trunk_d = Prop("crate", 11, 10)
shrine = Prop("altar", 7, 2)
statue = Prop("statue", 13, 2, 0.8)
torch = Prop("torch", 4, 11)
guest = NPC("guest", "無名的客人", 11, 4, "stranger", "mournful", "#4b5563", "slim", "hood", "lantern")
letter_two = Treasure("letter_two", 2, 12, ["蠟封的信"])
letter_three = Treasure("letter_three", 12, 12, ["燒焦一角的信"])
exit = Exit(7, 13, "月見湯")
attic = Quest("attic", "在閣樓裡找到剩下的兩封信。")
