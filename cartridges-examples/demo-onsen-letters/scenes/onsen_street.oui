root = Scene("湯屋街", "onsen_town", [contract, floor, sky, ambient, lanterns, pool_w, pool_e, stone_path, back_wall, well, torch_a, torch_b, torch_c, fence_a, fence_b, sign, rock, flowers, chiyo, koharu, unsui, letter_one, steam_gate, exit, letters])
contract = Contract("onsen_street", "tps_exploration@1", [], [], "carry", ["heard_rumor"], false)
floor = Floor(23, 23, "wood")
sky = Sky("#1c1520", "#2a1f28", 0.06)
ambient = Light("ambient", "#e0b7c4", 0.55)
lanterns = Light("point", "#ffd0a8", 1.7, 11, 11)
pool_w = Patch(2, 4, 4, 4, "water")
pool_e = Patch(17, 5, 4, 3, "water")
stone_path = Patch(10, 3, 3, 18, "stone")
back_wall = Wall(0, 0, 23, 2, "wood")
well = Prop("well", 15, 13)
torch_a = Prop("torch", 9, 6)
torch_b = Prop("torch", 13, 6)
torch_c = Prop("torch", 9, 17)
fence_a = Prop("fence", 2, 10)
fence_b = Prop("fence", 20, 10)
sign = Prop("signpost", 13, 18)
rock = Prop("rock", 5, 19, 1.2)
flowers = Prop("flower", 18, 17)
chiyo = NPC("chiyo", "千代", 12, 9, "merchant", "calm", "#b0426a", "tall", "ribbon", "fan")
koharu = NPC("koharu", "小春", 7, 13, "child", "joyful", "#f2b84b")
unsui = NPC("unsui", "雲水", 17, 15, "monk", "cryptic", "#5d6b8a")
letter_one = Treasure("letter_one", 4, 17, ["褪色的信"])
steam_gate = Trigger("steam_gate", 11, 4, 2, "steam_gate")
exit = Exit(11, 3, "湯屋閣樓")
letters = Quest("letters", "向街上的人打聽，誰寄了那三封沒有署名的信。")
