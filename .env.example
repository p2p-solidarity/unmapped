# Cloud provider key (only read by the Electron main process; never shipped to the renderer)
OPENAI_API_KEY=sk-your-key-here
# Optional: OpenUI Gateway key for https://api.thesys.dev/v1/embed (OUI-1 / multi-provider)
THESYS_API_KEY=

# Optional: which image model draws a world's assets (main process only).
# Values this account can use: gpt-image-1-mini (default), gpt-image-1, gpt-image-1.5, gpt-image-2.
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=

# Optional on-chain provenance (contracts/src/UnwrittenLedger.sol). Everything works without it.
# Reading needs the RPC and the address; publishing also needs the key, which stays in main.
UNWRITTEN_RPC_URL=
UNWRITTEN_CHAIN_ID=
UNWRITTEN_LEDGER_ADDRESS=
UNWRITTEN_PRIVATE_KEY=

# Optional cartridge ENS names on Sepolia ENSv2 (<cartridgeId>.<parent>). `bun run ens:setup <label>`
# registers <label>.eth with UNWRITTEN_PRIVATE_KEY (spends Sepolia test ETH) and prints these three.
UNWRITTEN_ENS_PARENT=
UNWRITTEN_ENS_REGISTRY=
UNWRITTEN_ENS_RESOLVER=
# Defaults to https://ethereum-sepolia-rpc.publicnode.com
UNWRITTEN_ENS_RPC_URL=

# Optional lineage market (Worlds → Market; contracts/README.md). `bun run lineage:market <label>`
# prints the UNWRITTEN_LINEAGE_* addresses. The app holds no key for it: writes go through the gas
# station (src/relay, `bun run relay:deploy`), and without UNWRITTEN_LINEAGE_RELAY the market is read-only.
UNWRITTEN_LINEAGE_PARENT=
UNWRITTEN_LINEAGE_REGISTRY=
UNWRITTEN_LINEAGE_HOOK=
UNWRITTEN_LINEAGE_ROUTER=
UNWRITTEN_LINEAGE_ACCOUNTS=
UNWRITTEN_LINEAGE_RELAY=
