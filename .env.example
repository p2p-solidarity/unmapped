# Cloud provider key (only read by the Electron main process; never shipped to the renderer)
OPENAI_API_KEY=sk-your-key-here
# Optional: OpenUI Gateway key for https://api.thesys.dev/v1/embed (OUI-1 / multi-provider)
THESYS_API_KEY=

# Optional: which image model draws a world's assets (main process only).
# Values this account can use: gpt-image-1-mini (default), gpt-image-1, gpt-image-1.5, gpt-image-2.
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=

# Optional on-chain provenance (contracts/src/UnwrittenLedger.sol). Everything works without it.
# Reading needs the RPC and the address; publishing also needs the key, which stays in main.
UNWRITTEN_RPC_URL=
UNWRITTEN_CHAIN_ID=
UNWRITTEN_LEDGER_ADDRESS=
UNWRITTEN_PRIVATE_KEY=

# Optional cartridge ENS names on Sepolia ENSv2 (<cartridgeId>.<parent>). `bun run ens:setup <label>`
# registers <label>.eth with UNWRITTEN_PRIVATE_KEY (spends Sepolia test ETH) and prints these three.
UNWRITTEN_ENS_PARENT=
UNWRITTEN_ENS_REGISTRY=
UNWRITTEN_ENS_RESOLVER=
# Defaults to https://ethereum-sepolia-rpc.publicnode.com
UNWRITTEN_ENS_RPC_URL=

# Optional lineage market (Worlds → Market; contracts/README.md). `bun run lineage:market <label>`
# prints the UNWRITTEN_LINEAGE_* addresses. The app holds no key for it: writes go through the gas
# station (src/relay, `bun run relay:deploy`), and without UNWRITTEN_LINEAGE_RELAY the market is read-only.
UNWRITTEN_LINEAGE_PARENT=
UNWRITTEN_LINEAGE_REGISTRY=
UNWRITTEN_LINEAGE_HOOK=
UNWRITTEN_LINEAGE_ROUTER=
UNWRITTEN_LINEAGE_ACCOUNTS=
UNWRITTEN_LINEAGE_RELAY=

# Image providers (rev 6 phase 4, D4; Settings → Images picks one, main keeps the choice).
# Self-hosted Qwen-Image served by vLLM-Omni (`vllm serve Qwen/Qwen-Image-2512 --omni --port 8091`).
# Main only: https://, or http:// on this computer. Default http://127.0.0.1:8091/v1.
QWEN_IMAGE_BASE_URL=
# Its key, if the server wants one: a key saved in the app comes first, this is the fallback.
QWEN_IMAGE_API_KEY=
# 1 = commercial mode: only image providers whose licence allows commercial use may draw, and a
# revision may not add a picture with a non-commercial or unknown licence (docs/licenses/models.md).
UNMAPPED_COMMERCIAL=

# Optional light chain, read-only (rev 6 phase 4, D6; contracts/src/provenance/WorldProvenance.sol).
# The door compares this device's copy of a shared world with the beat fingerprints its service
# recorded (public metadata: world id, entry number and hashes, never content). Main reads these
# only; the app signs nothing and needs no wallet. Separate from the UNWRITTEN_* ledger above.
# Leave them empty and every screen still works: the door says no chain is set up.
UNMAPPED_PROVENANCE_RPC_URL=
UNMAPPED_PROVENANCE_ADDRESS=
# Optional: when set, the RPC must report this chain id (Ethereum Sepolia is 11155111).
UNMAPPED_PROVENANCE_CHAIN_ID=

# The UNMAPPED generation gateway (rev 6 phase 4, D1–D3): a free allowance on an account of device
# keys, and plans. Main reads these only; no screen ever sees a token. Leave the URL
# empty and nothing is hosted (development builds have no gateway). Routing order (Settings → Model
# shows it): a local model; else your own key (saved, then OPENAI_API_KEY / THESYS_API_KEY); only
# with no own key, or with "Free allowance" selected, the gateway. A failure never falls through to
# the next step. The gateway's address: https://, or http://127.0.0.1:<port> for one on this machine
# (`bun run gateway -- --port 8788 --data <dir>`); /v1 is added when missing.
UNMAPPED_GATEWAY_URL=
# An account token for .env, made only by the gateway's operator CLI
# (`bun run gateway -- token <accountId>`); the app never shows one. A token saved by signing in
# (Settings → Account) comes first; this is the fallback, and it is never deleted by the app.
UNMAPPED_GATEWAY_KEY=
# none = log the billing page's address instead of opening the browser (E2E runs only).
UNMAPPED_BILLING_BROWSER=
